<div>
    <fieldset class="flexrow">
        <button type="button" data-action="selectAll" class="icon fas fa-users ui-control" aria-pressed="{{allTokens}}"></button>
        <button type="button" data-action="selectSingle" class="icon fas fa-user ui-control" aria-pressed="{{not allTokens}}"></button>
    </fieldset>
    <fieldset class="flexrow">
        <button type="button" data-action="stepBackward" class="icon fas fa-angle-left" {{#if stepping}}disabled{{/if}}></button>
        <button type="button" data-action="toggleStepping" class="icon fas {{#if stepping}}fa-pause{{else}}fa-play{{/if}}"></button>
        <button type="button" data-action="stepForward" class="icon fas fa-angle-right" {{#if stepping}}disabled{{/if}}></button>
    </fieldset>
</div>