<div>
    <fieldset class="flexrow">
        <button type="button" data-action="selectAll" class="icon fas fa-users ui-control" aria-pressed="true"></button>
        <button type="button" data-action="selectSingle" class="icon fas fa-user ui-control"></button>
    </fieldset>
    <fieldset class="flexrow">
        <button type="button" data-action="stepBackward" class="icon fas fa-angle-left"></button>
        <button type="button" data-action="toggleStepping" class="icon fas fa-play"></button>
        <button type="button" data-action="stepForward" class="icon fas fa-angle-right"></button>
    </fieldset>
</div>