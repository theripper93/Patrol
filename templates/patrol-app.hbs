<div>
    <fieldset class="flexrow">
        <button type="button"
            data-action="selectAll"
            data-tooltip="{{localize "patrol.patrol-app.selectAll"}}"
            aria-pressed="{{allTokens}}"
            class="icon fas fa-users ui-control"
            {{#if stepping}}disabled{{/if}}>
        </button>
        <button type="button"
            data-action="selectSingle"
            data-tooltip="{{localize "patrol.patrol-app.selectSingle"}}"
            aria-pressed="{{not allTokens}}"
            class="icon fas fa-user ui-control"
            {{#if stepping}}disabled{{/if}}>
        </button>
    </fieldset>
    <fieldset class="flexrow">
        <button type="button"
            data-action="stepBackward"
            data-tooltip="{{localize "patrol.patrol-app.stepBackward"}}"
            class="icon fas fa-angle-left"
            {{#if stepping}}disabled{{/if}}>
        </button>
        <button type="button"
            data-action="toggleStepping"
            data-tooltip="{{localize "patrol.patrol-app.toggleStepping"}}"
            class="icon fas {{#if stepping}}fa-pause{{else}}fa-play{{/if}}"
            {{#unless allTokens}}disabled{{/unless}}>
        </button>
        <button type="button"
            data-action="stepForward"
            data-tooltip="{{localize "patrol.patrol-app.stepForward"}}"
            class="icon fas fa-angle-right"
            {{#if stepping}}disabled{{/if}}>
        </button>
    </fieldset>
</div>